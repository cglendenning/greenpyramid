<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Firebase Messaging requires APNs registration for remote push. The
	     release provisioning profile supplies the production environment. -->
	<key>aps-environment</key>
	<string>production</string>
	<!-- Required for Firebase App Check's AppleProvider.appAttest (main.dart)
	     to work at all — DCAppAttestService silently fails token requests
	     without it. Release signing supplies the production capability grant. -->
	<key>com.apple.developer.devicecheck.appattest-environment</key>
	<string>production</string>
	<!-- D-148: required for sign_in_with_apple (AccountLinkService). Xcode's
	     automatic signing (already in use for this project) is expected to
	     self-provision the "Sign In with Apple" capability on the App ID
	     from this key alone; verify at the next build and fall back to a
	     manual Apple Developer portal toggle if it doesn't. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
